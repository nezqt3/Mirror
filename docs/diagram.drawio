  <diagram id="mirror-trust-architecture" name="02 — Приватность и система">
    <mxGraphModel dx="1357" dy="935" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="tt" value="&lt;b&gt;Приватность — часть ценности Mirror&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;Пользователь контролирует момент сбора, а данные служат личному улучшению, не наблюдению.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#0F172A;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1050" height="65" as="geometry" /></mxCell>
        <mxCell id="device" value="&lt;b&gt;Устройство пользователя&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#166534&#39;&gt;Только добровольная&lt;br&gt;Focus Session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#0F172A;fontSize=16;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="215" width="190" height="105" as="geometry" /></mxCell>
        <mxCell id="local" value="&lt;b&gt;Локальная граница&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;Electron Main + Adapter&lt;br&gt;Нормализованные события&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#0F172A;fontSize=16;shadow=1;" vertex="1" parent="1"><mxGeometry x="340" y="215" width="210" height="105" as="geometry" /></mxCell>
        <mxCell id="analysis" value="&lt;b&gt;Разрешённый анализ&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;Агрегация → AI-отчёт&lt;br&gt;без keylogging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=2;fontColor=#0F172A;fontSize=16;shadow=1;" vertex="1" parent="1"><mxGeometry x="630" y="215" width="200" height="105" as="geometry" /></mxCell>
        <mxCell id="result" value="&lt;b&gt;Понятный результат&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#4338CA&#39;&gt;Goal Completion&lt;br&gt;барьер + следующий шаг&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#0F172A;fontSize=16;shadow=1;" vertex="1" parent="1"><mxGeometry x="910" y="215" width="190" height="105" as="geometry" /></mxCell>
        <mxCell id="te1" edge="1" parent="1" source="device" target="local" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#22C55E;strokeWidth=2;endArrow=block;endFill=1;" value="только с согласия"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te2" edge="1" parent="1" source="local" target="analysis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="агрегированные сигналы"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te3" edge="1" parent="1" source="analysis" target="result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;endFill=1;" value="персональный вывод"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1" value="✓ Пользователь запускает и завершает сбор сам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#334155;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="285" height="55" as="geometry" /></mxCell>
        <mxCell id="p2" value="✓ UI не получает прямого доступа к системным API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#334155;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="325" height="55" as="geometry" /></mxCell>
