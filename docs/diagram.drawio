  </diagram>
  <diagram id="mirror-data-pipeline" name="03 — Данные → инсайт → графики">
    <mxGraphModel dx="1357" dy="935" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="ptitle" value="&lt;b&gt;Как работа человека становится персональной аналитикой Mirror&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;Сигналы → проверенные события → AI‑отчёт → графики и рост персонажа.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#0F172A;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1060" height="65" as="geometry" /></mxCell>
        <mxCell id="lcollect" value="1. ВО ВРЕМЯ РАБОТЫ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=none;fontColor=#475569;fontSize=12;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="250" height="370" as="geometry" /></mxCell>
        <mxCell id="lstore" value="2. ХРАНЕНИЕ И ОЧЕРЕДЬ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=none;fontColor=#475569;fontSize=12;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="305" y="120" width="270" height="370" as="geometry" /></mxCell>
        <mxCell id="lanalyze" value="3. АНАЛИЗ И НАГРАДА" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=none;fontColor=#92400E;fontSize=12;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="595" y="120" width="250" height="370" as="geometry" /></mxCell>
        <mxCell id="lshow" value="4. ЧТО ВИДИТ ЧЕЛОВЕК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=none;fontColor=#4338CA;fontSize=12;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="865" y="120" width="270" height="370" as="geometry" /></mxCell>
        <mxCell id="capture" value="&lt;b&gt;Native Capture&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;macOS / Windows&lt;br&gt;приложение, окно, браузер,&lt;br&gt;idle, переключения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="65" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="bridge" value="&lt;b&gt;Focus Session UI&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;очередь пачек до 1 000&lt;br&gt;RawActivityEvent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="65" y="350" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="sessions" value="&lt;b&gt;focus_sessions&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;цель, время, timezone&lt;br&gt;active → processing → completed&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="175" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="events" value="&lt;b&gt;activity_events&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;occurred_at, type, payload&lt;br&gt;уникальный client_event_id&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="queue" value="&lt;b&gt;Redis + Celery&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;задача analyze_session&lt;br&gt;после finish&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="625" y="175" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="aiworker" value="&lt;b&gt;AI worker&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;восстанавливает сессию&lt;br&gt;находит паттерн и барьер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="625" y="330" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="reports" value="&lt;b&gt;session_reports&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;focus_score, deep_work,&lt;br&gt;switches, bottleneck, advice&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=2;fontColor=#0F172A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="895" y="170" width="210" height="95" as="geometry" /></mxCell>
        <mxCell id="character" value="&lt;b&gt;characters&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;XP, level, focus, stamina,&lt;br&gt;execution, discipline&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=2;fontColor=#0F172A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="895" y="320" width="210" height="95" as="geometry" /></mxCell>
        <mxCell id="screen" value="&lt;b&gt;Analytics &amp;amp; History&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#4338CA&#39;&gt;графики недели, средний Focus,&lt;br&gt;время deep work, советы AI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="895" y="555" width="210" height="95" as="geometry" /></mxCell>
        <mxCell id="pe1" edge="1" parent="1" source="capture" target="bridge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="события"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe2" edge="1" parent="1" source="bridge" target="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="POST /events/batch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe3" edge="1" parent="1" source="bridge" target="sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="создать / завершить"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe4" edge="1" parent="1" source="sessions" target="queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;endFill=1;" value="finish"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe5" edge="1" parent="1" source="queue" target="aiworker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe6" edge="1" parent="1" source="events" target="aiworker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" value="контекст сессии"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe7" edge="1" parent="1" source="aiworker" target="reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;" value="итог"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe8" edge="1" parent="1" source="aiworker" target="character" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;" value="награды"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe9" edge="1" parent="1" source="reports" target="screen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;" value="GET /report"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe10" edge="1" parent="1" source="character" target="screen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;" value="GET /character"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="warning" value="&lt;b&gt;Почему график не обновляется сам:&lt;/b&gt; Analytics загружается один раз при открытии. Пока worker не сохранил report — статус processing; после сохранения UI не делает poll/reload автоматически." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;fontColor=#991B1B;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="710" width="930" height="62" as="geometry" /></mxCell>
