  <diagram id="mirror-user-journey" name="01 — Путь пользователя">
    <mxGraphModel dx="1357" dy="935" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Mirror: от намерения к устойчивому улучшению&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;Продукт измеряет не экранное время, а движение к результату.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0F172A;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1050" height="60" as="geometry" /></mxCell>
        <mxCell id="lane1" value="ВО ВРЕМЯ FOCUS SESSION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=none;fontColor=#475569;fontSize=12;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1060" height="190" as="geometry" /></mxCell>
        <mxCell id="lane2" value="ЦЕННОСТЬ ПОСЛЕ СЕССИИ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=none;fontColor=#475569;fontSize=12;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1060" height="190" as="geometry" /></mxCell>
        <mxCell id="j1" value="&lt;b&gt;1. Ясная цель&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;«Закончить pitch deck»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="75" y="185" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="j2" value="&lt;b&gt;2. Focus Session&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;90 минут намеренной работы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="330" y="185" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="j3" value="&lt;b&gt;3. Разрешённый контекст&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;сигналы, активность, переключения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="595" y="185" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="j4" value="&lt;b&gt;4. AI понимает ход работы&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;а не только число часов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="870" y="185" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="j5" value="&lt;b&gt;5. Один точный вывод&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;главный барьер сессии&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="870" y="415" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="j6" value="&lt;b&gt;6. Следующий шаг&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;конкретный совет AI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="595" y="415" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="j7" value="&lt;b&gt;7. Видимый прогресс&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;XP, Focus, Execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="330" y="415" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="j8" value="&lt;b&gt;8. Сессия лучше&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#64748B&#39;&gt;новая, более сильная точка старта&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="75" y="415" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="je1" edge="1" parent="1" source="j1" target="j2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="je2" edge="1" parent="1" source="j2" target="j3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="je3" edge="1" parent="1" source="j3" target="j4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="je4" edge="1" parent="1" source="j4" target="j5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="je5" edge="1" parent="1" source="j5" target="j6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="je6" edge="1" parent="1" source="j6" target="j7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="je7" edge="1" parent="1" source="j7" target="j8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6366F1;strokeWidth=2;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="quote" value="&lt;b&gt;Главная мысль для демо:&lt;/b&gt; Mirror не просит работать больше — он помогает понять, что изменить в следующей сессии." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#F8FAFC;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="130" y="590" width="880" height="60" as="geometry" /></mxCell>
      </root>
